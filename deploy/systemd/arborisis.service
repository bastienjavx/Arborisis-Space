[Unit]
Description=Arborisis — serveur de jeu dédié
Documentation=https://github.com/bastienjavx/arborisis-space/blob/main/docs/SELF_HOSTING.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@INSTALL_DIR@
# Les migrations sont appliquées par le service `migrate` avant l'API : un simple
# `up -d` suffit après une mise à jour du dépôt ou un redémarrage machine.
ExecStart=/usr/bin/docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env down
ExecReload=/usr/bin/docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env restart
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
