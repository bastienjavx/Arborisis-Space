# ─────────────────────────────────────────────────────────────────────────────
# Arborisis — configuration du serveur dédié (auto-hébergement).
#
# `./install.sh` génère `deploy/.env` à partir de ce modèle et remplit tous les
# secrets automatiquement. Éditer ce fichier à la main n'est utile que pour
# personnaliser le dimensionnement, le SMTP ou le domaine après coup
# (`arborisis update` applique les changements).
#
# NE JAMAIS COMMITER `deploy/.env` : il contient les secrets de production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Exposition publique ──────────────────────────────────────────────────────
# URL canonique publique, SANS slash final. Sert d'origine CORS, d'origine des
# cookies, de base des liens e-mail et des métadonnées SEO.
PUBLIC_URL=https://arborisis.example.com

# Adresse de site Caddy :
#   arborisis.example.com  → HTTPS automatique (le port 80 doit être joignable)
#   :80                    → HTTP simple (IP nue, LAN, ou TLS terminé en amont)
SITE_ADDRESS=arborisis.example.com

# E-mail de contact ACME (expiration de certificat). Requis en HTTPS automatique.
ACME_EMAIL=admin@example.com

# Domaine des cookies. Laisser vide sauf partage entre sous-domaines (ex. .example.com).
COOKIE_DOMAIN=

# Interfaces d'écoute publiques. Restreindre à 127.0.0.1 si un proxy tourne devant.
HTTP_BIND=0.0.0.0
HTTPS_BIND=0.0.0.0

# Fuseau horaire des conteneurs.
TZ=UTC

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=arborisis
POSTGRES_DB=arborisis
# Généré par install.sh.
POSTGRES_PASSWORD=

# Publication du port Postgres. Loopback uniquement : outils d'admin locaux et
# sauvegardes. NE JAMAIS mettre 0.0.0.0.
POSTGRES_BIND=127.0.0.1:5432

# Dimensionnement — valeurs prudentes pour ~4 Go de RAM.
# 8 Go  : shared_buffers=2GB,  effective_cache_size=6GB
# 16 Go : shared_buffers=4GB,  effective_cache_size=12GB
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB

# Taille du pool Prisma PAR conteneur (api + workers). Garder
# (nb de conteneurs applicatifs × PRISMA_CONNECTION_LIMIT) < POSTGRES_MAX_CONNECTIONS.
PRISMA_CONNECTION_LIMIT=10
PRISMA_STATEMENT_TIMEOUT_MS=30000

# ── Redis (BullMQ, throttling, verrous) ──────────────────────────────────────
# Généré par install.sh.
REDIS_PASSWORD=
REDIS_MAXMEMORY=512mb

# ── Secrets applicatifs (générés par install.sh) ─────────────────────────────
# Rotation manuelle : `openssl rand -hex 32`, puis `arborisis restart`.
# Changer les secrets JWT invalide toutes les sessions en cours.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
# Chiffrement au repos des secrets TOTP (2FA).
TOTP_ENC_KEY=
# Signature du cookie de routage d'univers, côté web.
UNIVERSE_COOKIE_SECRET=

# ── Gameplay ─────────────────────────────────────────────────────────────────
# Nombre de joueurs par univers avant saturation. Voir docs/SELF_HOSTING.md
# pour ajouter un univers sur une installation auto-hébergée.
UNIVERSE_MAX_PLAYERS=500

# Services optionnels activés en permanence. Décommenter pour faire tourner le
# worker de provisioning ; sans cela, `arborisis up --remove-orphans` le supprime.
# COMPOSE_PROFILES=provisioning

# ── SMTP (vérification d'e-mail, notifications) ──────────────────────────────
# Sans identifiants, les envois échouent : les comptes restent non vérifiés.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@arborisis.game

# ── SEO (optionnel) ──────────────────────────────────────────────────────────
GOOGLE_SITE_VERIFICATION=

# ── Sauvegardes ──────────────────────────────────────────────────────────────
# Répertoire hôte des dumps `arborisis backup` (relatif au dépôt si non absolu).
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
